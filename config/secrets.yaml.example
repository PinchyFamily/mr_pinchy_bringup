# Mr Pinchy secrets — template.
# Copy to config/secrets.yaml (gitignored), fill in, and keep it private:
#   cp config/secrets.yaml.example config/secrets.yaml && chmod 600 config/secrets.yaml
#
# One file for every credential the vehicle needs. Consumers:
#   ntrip        -> launch/gnss.launch.py (ntrip_client node), scripts/test_ntrip.py
#   nucleus      -> launch/bringup.launch.py, launch/carl.launch.py (nucleus_driver_ros2 connect_tcp)
#   access_point -> mr_pinchy/setup/ap/install-ap.sh (pinchy-ap hostapd passphrase)
#   wifi         -> lab Wi-Fi client (Raspberry Pi Imager / netplan), reference only
#   modem        -> SIM7600G-H 4G modem (see mr_pinchy docs, vehicle/4g-modem), reference only

ntrip:
  # SWEPOS network RTK (Lantmäteriet)
  host: "nrtk-swepos.lm.se"
  port: 8500
  mountpoint: "MSM_GEC"
  use_https: false
  username: "CHANGE_ME"
  password: "CHANGE_ME"

nucleus:
  # Nortek Nucleus DVL, TCP connection
  host: "CHANGE_ME"         # IP address on the vehicle network
  password: "CHANGE_ME"

access_point:
  # SSID is set in mr_pinchy/setup/ap/hostapd.conf.example
  passphrase: "CHANGE_ME"   # WPA2, 8-63 characters

wifi:
  ssid: "CHANGE_ME"
  password: "CHANGE_ME"     # plain passphrase or 64-hex PSK

modem:
  apn: "internet.tele2.se"
  sim_pin: ""
